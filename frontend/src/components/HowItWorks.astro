---
const steps = [
  {
    num: "1",
    title: "Instala la extension",
    desc: "Descarga STACY desde el marketplace de VS Code e instalalo con un solo clic.",
    code: "Ir a Extensiones > Buscar 'STACY' > Instalar",
  },
  {
    num: "2",
    title: "Inicia sesion con Google",
    desc: "Haz clic en 'Continuar con Google' y autenticate con tu cuenta. Sin registros complicados.",
    code: "Un clic y listo",
  },
  {
    num: "3",
    title: "Tus comandos se sincronizan solos",
    desc: "Cada comando que ejecutas en tu terminal se guarda automaticamente. Accede desde cualquier dispositivo.",
    code: "Simplemente usa tu terminal como siempre",
  },
];
---

<section id="how-it-works" class="section section-alt">
  <div class="section-inner">
    <h2 class="section-title">Como funciona</h2>
    <p class="section-desc">En solo 3 pasos</p>
    <div class="steps">
      {steps.map(s => (
        <div class="step">
          <div class="step-left">
            <span class="step-num">{s.num}</span>
          </div>
          <div class="step-content">
            <h3 class="step-title">{s.title}</h3>
            <p class="step-desc">{s.desc}</p>
            <code class="step-code">{s.code}</code>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .section-alt {
    background: var(--surface);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }

  .section {
    padding: 4rem 1.5rem;
  }

  .section-inner {
    max-width: 640px;
    margin: 0 auto;
  }

  .section-title {
    font-size: 1.8rem;
    font-weight: 800;
    color: var(--accent);
    text-align: center;
    letter-spacing: -0.02em;
  }

  .section-desc {
    text-align: center;
    color: var(--text-secondary);
    font-size: 0.95rem;
    margin: 0.5rem 0 2.5rem;
  }

  .steps {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .step {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.25rem;
    transition: all var(--transition);
  }

  .step:hover {
    border-color: rgba(245, 158, 11, 0.2);
  }

  .step-left {
    flex-shrink: 0;
  }

  .step-num {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--accent);
    color: #0d1117;
    font-size: 1rem;
    font-weight: 800;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 2px 8px rgba(245, 158, 11, 0.25);
  }

  .step-content {
    flex: 1;
    min-width: 0;
  }

  .step-title {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--text);
    margin-bottom: 0.3rem;
  }

  .step-desc {
    font-size: 0.85rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .step-code {
    display: inline-block;
    font-family: "JetBrains Mono", "Consolas", monospace;
    font-size: 0.78rem;
    color: var(--accent);
    background: var(--accent-dim);
    border-radius: var(--radius-sm);
    padding: 0.3rem 0.6rem;
    margin-top: 0.5rem;
  }
</style>
