---
const features = [
  {
    icon: "sync",
    title: "Sincronizacion automatica",
    desc: "Todos los comandos que ejecutas en tu terminal de VS Code se guardan y sincronizan automaticamente con la nube.",
  },
  {
    icon: "devices",
    title: "Acceso multi-dispositivo",
    desc: "Accede a tu historial desde cualquier equipo. Inicia sesion con Google y tus comandos te siguen a donde vayas.",
  },
  {
    icon: "folder",
    title: "Organizacion en carpetas",
    desc: "Clasifica tus comandos en carpetas personalizadas. Encuentralos rapidamente cuando los necesites.",
  },
  {
    icon: "note",
    title: "Notas personales",
    desc: "Agrega notas a tus comandos para recordar contexto, parametros o trucos importantes.",
  },
];

const icons = {
  sync: '<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 4 23 10 17 10"/><polyline points="1 20 1 14 7 14"/><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/></svg>',
  devices: '<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>',
  folder: '<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></svg>',
  note: '<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>',
};
---

<section id="features" class="section">
  <div class="section-inner">
    <h2 class="section-title">Funciones</h2>
    <p class="section-desc">Todo lo que necesitas para gestionar tu historial de comandos</p>
    <div class="features-grid">
      {features.map(f => (
        <article class="feature-card">
          <div class="feature-icon" set:html={icons[f.icon]} />
          <h3 class="feature-title">{f.title}</h3>
          <p class="feature-desc">{f.desc}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .section {
    padding: 4rem 1.5rem;
  }

  .section-inner {
    max-width: 1100px;
    margin: 0 auto;
  }

  .section-title {
    font-size: 1.8rem;
    font-weight: 800;
    color: var(--accent);
    text-align: center;
    letter-spacing: -0.02em;
  }

  .section-desc {
    text-align: center;
    color: var(--text-secondary);
    font-size: 0.95rem;
    margin: 0.5rem 0 2.5rem;
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1rem;
  }

  .feature-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.5rem;
    transition: all var(--transition);
  }

  .feature-card:hover {
    border-color: rgba(245, 158, 11, 0.25);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);
    transform: translateY(-2px);
  }

  .feature-icon {
    width: 48px;
    height: 48px;
    border-radius: 12px;
    background: var(--accent-dim);
    color: var(--accent);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1rem;
  }

  .feature-title {
    font-size: 1rem;
    font-weight: 700;
    color: var(--text);
    margin-bottom: 0.4rem;
  }

  .feature-desc {
    font-size: 0.85rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }
</style>
