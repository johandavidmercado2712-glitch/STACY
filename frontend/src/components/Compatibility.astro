---
const platforms = [
  { name: "Linux", icon: '<svg viewBox="0 0 24 24" width="40" height="40" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2C9.5 2 7 4 7 7c0 2.5 2 5 5 5s5-2.5 5-5c0-3-2.5-5-5-5z"/><path d="M12 12v10"/><path d="M8 18c3 1 5 1 8 0"/></svg>' },
  { name: "macOS", icon: '<svg viewBox="0 0 24 24" width="40" height="40" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="4" width="16" height="16" rx="4"/><line x1="4" y1="12" x2="20" y2="12"/><line x1="12" y1="4" x2="12" y2="20"/><line x1="8" y1="4" x2="8" y2="20"/><line x1="16" y1="4" x2="16" y2="20"/></svg>' },
  { name: "Windows", icon: '<svg viewBox="0 0 24 24" width="40" height="40" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="9" y1="3" x2="9" y2="21"/><line x1="15" y1="3" x2="15" y2="21"/></svg>' },
];
---

<section id="compatibility" class="section">
  <div class="section-inner">
    <h2 class="section-title">Compatibilidad</h2>
    <p class="section-desc">Funciona en los sistemas operativos mas populares</p>
    <div class="platforms">
      {platforms.map(p => (
        <div class="platform-card">
          <div class="platform-icon" set:html={p.icon} />
          <span class="platform-name">{p.name}</span>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .section {
    padding: 4rem 1.5rem;
  }

  .section-inner {
    max-width: 640px;
    margin: 0 auto;
  }

  .section-title {
    font-size: 1.8rem;
    font-weight: 800;
    color: var(--accent);
    text-align: center;
    letter-spacing: -0.02em;
  }

  .section-desc {
    text-align: center;
    color: var(--text-secondary);
    font-size: 0.95rem;
    margin: 0.5rem 0 2.5rem;
  }

  .platforms {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .platform-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    padding: 1.5rem 2.5rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    transition: all var(--transition);
  }

  .platform-card:hover {
    border-color: rgba(245, 158, 11, 0.25);
    transform: translateY(-2px);
  }

  .platform-icon {
    color: var(--accent);
    opacity: 0.8;
  }

  .platform-name {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text);
  }
</style>
